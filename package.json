{
  "name": "four-in-a-row",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "PGLITE_DIR=pglite-data react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@activescott/auth": "^5.9.0",
    "@activescott/auth-adapter-react-router": "^3.1.0",
    "@activescott/auth-provider-email": "^3.2.2",
    "@activescott/auth-provider-passkey": "^2.3.0",
    "@activescott/auth-store-prisma": "^0.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "isbot": "^5.2.3",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.1",
