{
  "name": "four-in-a-row",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "PGLITE_DIR=pglite-data react-router dev",
    "build": "react-router build",
    "start": "node server.mjs",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prisma": "CHECKPOINT_DISABLE=1 prisma",
    "check:no-checkpoint": "node scripts/check-no-checkpoint.mjs",
    "check:playwright-image": "node scripts/check-playwright-image.mjs"
  },
  "dependencies": {
    "@activescott/auth": "^6.0.0",
    "@activescott/auth-adapter-react-router": "^3.1.1",
    "@activescott/auth-provider-email": "^3.2.3",
    "@activescott/auth-provider-passkey": "^3.0.0",
    "@activescott/auth-store-prisma": "^0.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-router/express": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "express": "^5.3.0",
    "isbot": "^5.2.3",
    "nodemailer": "^10.5.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.10.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
